# Auto Video Gen 2.0 Preview - system settings only.
# AI/Voice API connections are managed from Dashboard -> Set API
# and stored encrypted under DATA_DIR/connections.json.

HOST=0.0.0.0
PORT=3080
BASE_REPO_DIR=/opt/auto-video-gen/base
DATA_DIR=/opt/auto-video-gen/data
DOWNLOAD_OUTPUT_DIR=/opt/auto-video-gen/downloads
MAX_UPLOAD_MB=25
MAX_SOURCE_CHARS=100000

# Optional dashboard Basic Auth
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# AI execution defaults (keys/models are NOT required here)
AI_MAX_TOKENS=12000
AI_REQUEST_TIMEOUT_MS=180000
AI_RATE_LIMIT_MAX_WAIT_MS=60000
SCRIPT_REPAIR_ATTEMPTS=3

# TTS/render behavior
VIENEU_TIMEOUT_MS=900000
TTS_DURATION_CHECK=false
TTS_DURATION_REPAIR_ATTEMPTS=0
TTS_PRONUNCIATION_RULES=OSI=ô ét ai

# Branding defaults
VIDEO_BRAND_LOGO_PATH=/opt/auto-video-gen/branding/logo.png
TIKTOK_AVATAR_PATH=/opt/auto-video-gen/branding/avatar.png
TIKTOK_DISPLAY_NAME=Khám Phá Cùng Nhân
TIKTOK_HANDLE=@vophamhoangnhan
VIDEO_THEME=dark-neon

# MIGRATION ONLY:
# If DATA_DIR/connections.json does not exist, V2 Preview imports any
# GitHub/VieNeu/LucyLab/API settings found in the existing .env.local once.
# After import, manage them through Set API.

# VieNeu-TTS stability tuning (optional; defaults are already enabled)
VIENEU_RETRY_ATTEMPTS=3
VIENEU_RETRY_DELAY_MS=4000
VIENEU_AUDIO_REPAIR_ATTEMPTS=3
VIENEU_CHUNK_MAX_CHARS=180
VIENEU_CHUNK_GAP_MS=140
VIENEU_AUDIO_VALIDATE=true
VIENEU_MAX_WORDS_PER_SEC=5.5
VIENEU_KEEP_CHUNK_CACHE=false
